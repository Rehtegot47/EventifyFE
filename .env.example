# API Base URL (backend)
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Maps API Key (for event location embeds)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# WhatsApp business number, international format, no + or spaces (e.g. 2348012345678).
# Powers the 'Buy on WhatsApp' button; the button hides itself if unset.
VITE_WHATSAPP_NUMBER=
